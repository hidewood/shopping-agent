# Copy this file to .env and fill in your own key. Never commit .env.
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
# Planning is a bounded JSON classification task; disable V4's default long
# thinking mode for lower latency. Enable only for controlled experiments.
DEEPSEEK_THINKING_ENABLED=false
AGENT_MAX_CANDIDATES=8
# One visible turn has a 30-second semantic-compilation budget. At most one
# side-effect-free protocol repair is allowed inside that budget.
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=0
DEEPSEEK_CIRCUIT_BREAKER_SECONDS=20

# Set APP_ENV=production only with a long random JWT secret and explicit
# browser origins. Comma-separate CORS_ORIGINS when serving more than one UI.
APP_ENV=development
JWT_SECRET_KEY=replace_with_a_long_random_secret_before_production
CORS_ORIGINS=http://localhost:5173

# Optional one-time administrator bootstrap. Set both values before first start;
# the password is stored only as a hash and this account is never overwritten.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
